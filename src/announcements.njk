---
layout: base.njk
title: Announcements
permalink: /announcements/
---

<div class="hero hero-center" style="margin-bottom: 2.5rem;">
  <h1 class="hero-title-main">Announcements</h1>
  <div class="hero-quote-wrapper">
    <p class="hero-quote">"Bulletins, news, and letters gathered around the hearth."</p>
  </div>
</div>

<div class="announcements-wrapper">
  {% set groupedAnnouncements = collections.announcements | groupByMonth %}

  {% if groupedAnnouncements and groupedAnnouncements.length > 0 %}
    {% for group in groupedAnnouncements %}
      <section class="announcements-date-group">
        <header class="announcements-month-header">
          <h2 class="announcements-month-title">{{ group.monthYear }}</h2>
        </header>

        <div class="announcements-list">
          {% for item in group.items %}
            <article class="announcement-entry{% if item.data.is_banner %} announcement-entry--featured{% endif %}" id="{{ item.fileSlug }}">
              <div class="announcement-entry__meta">
                <time class="announcement-entry__date" datetime="{{ item.date.toISOString() if item.date.toISOString else item.date }}">
                  {{ item.date | longDate }}
                </time>

                {% if item.data.badge %}
                  <span class="announcement-entry__badge">{{ item.data.badge }}</span>
                {% endif %}

                {% if item.data.is_banner %}
                  <span class="announcement-entry__featured-mark" title="Currently shown in the site banner">Featured</span>
                {% endif %}
              </div>

              <h3 class="announcement-entry__title">{{ item.data.title }}</h3>

              <div class="announcement-entry__content post-content">
                {{ item.templateContent | default(item.data.body | markdownify) | safe }}
              </div>

              {% if item.data.link_url %}
                <footer class="announcement-entry__footer">
                  <a href="{{ item.data.link_url }}" class="announcement-entry__link">
                    {{ item.data.link_text | default("Read the full notice") }}
                  </a>
                </footer>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% else %}
    <div class="announcements-empty">
      <p>No announcements currently posted. Check back soon for campfire news!</p>
    </div>
  {% endif %}
</div>
