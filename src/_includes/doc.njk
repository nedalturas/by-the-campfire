---
layout: base.njk
---

<div class="docs-wrapper">
  {# left sidebar #}

  <aside class="docs-sidebar" aria-label="Documentation Sidebar">
    <div class="sidebar-header">
      <span class="portal-badge">Internal Portal</span>
      <h2 class="sidebar-main-title">Docs & Guides</h2>
    </div>

  <nav class="sidebar-nav">
    {% for group in collections.docs | groupByCategory %}

    <div class="sidebar-group">
      <h3 class="sidebar-category-title">{{ group.category }}</h3>
      <ul class="sidebar-list">
        {% for item in group.items %}
        <li class="sidebar-item">
          <a href="{{ item.url }}" class="sidebar-link {% if item.url == page.url %}active{% endif %}">
            {{ item.data.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </nav>
  </aside>

  {# Main content area #}

  <main class="docs-article-container">
    <article class="doc-article">
      <header class="doc-header">
        {% if category %}
          <div class="doc-breadcrumbs">
            <span>Docs</span>
            <span class="breadcrum-separator">/</span>
            <span class="doc-category-badge">{{ category }}</span>
          </div>
        {% endif %}
        <h1 class="doc-title">{{ title }}</h1>
        {% if description %}
          <p class="doc-description">{{ description }}</p>
        {% endif %}
      </header>

      <div class="doc-content">
        {{ content | safe }}
      </div>

      <footer class="doc-footer">
        <a href="/docs/" class="back-to-docs-link">Back To Overview</a>
      </footer>
    </article>
  </main>

</div>
